pipeline {
    agent any

    stages {

        stage ("Checkout") {
            steps {
                echo "Checkout Repo"
            }
        }

        stage ("Build") {
            steps {
                echo "Installing Dependencies"
            }
        }

        stage ("Test") {
            steps {
                echo "Execution of Automated Testcases"
            }
        }

        stage ("Deploy") {
            steps {
                echo "Deploy to concerned Stage"
            }
        }

        
    }
}